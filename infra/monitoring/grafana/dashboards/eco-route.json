{
 "uid": "ecoroute",
 "title": "Eco-Route \u2013 City & Platform",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Open reports by priority",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ecoroute_open_reports",
     "legendFormat": "{{priority}}"
    }
   ]
  },
  {
   "id": 2,
   "title": "Reports past SLA",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ecoroute_sla_breached",
     "legendFormat": "breached"
    }
   ]
  },
  {
   "id": 3,
   "title": "Reports received / hour",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (category) (increase(ecoroute_reports_created_total[1h]))",
     "legendFormat": "{{category}}"
    }
   ]
  },
  {
   "id": 4,
   "title": "API requests / s",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (handler) (rate(http_requests_total[5m]))",
     "legendFormat": "{{handler}}"
    }
   ]
  },
  {
   "id": 5,
   "title": "API p95 latency (s)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, handler))",
     "legendFormat": "{{handler}}"
    }
   ]
  },
  {
   "id": 6,
   "title": "AI assistant calls by provider",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (provider) (increase(ecoroute_assistant_calls_total[1h]))",
     "legendFormat": "{{provider}}"
    }
   ]
  },
  {
   "id": 7,
   "title": "5xx error ratio",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_requests_total{status=\"5xx\"}[5m])) / sum(rate(http_requests_total[5m]))",
     "legendFormat": "errors"
    }
   ]
  }
 ]
}