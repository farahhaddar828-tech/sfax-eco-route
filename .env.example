# Copy to .env and fill in. Never commit .env.

POSTGRES_PASSWORD=change-me

# Where every report email goes (through n8n)
NOTIFY_EMAIL=your.email@example.com

# --- AI provider: claude | openai | grok | ollama | none
LLM_PROVIDER=ollama
LLM_MODEL=                 # empty = provider default (see backend/app/ai/llm.py)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# --- n8n
N8N_ENCRYPTION_KEY=change-me-long-random
N8N_BASIC_AUTH_PASSWORD=change-me
ECOROUTE_FROM_EMAIL=your.sender@gmail.com   # Gmail: create an App Password for the SMTP credential

GRAFANA_ADMIN_PASSWORD=change-me
